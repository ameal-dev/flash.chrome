{
  "manifest_version": 3,
  "name": "Flash Yank",
  "version": "0.1.0",
  "description": "EasyMotion-style text jumping for Chrome. Works with Vimium for visual selection and yanking.",
  "permissions": [],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "activate": {
      "suggested_key": {
        "default": "Ctrl+Shift+Alt+B",
        "mac": "Command+Shift+Alt+Ctrl+B"
      },
      "description": "Activate Flash Yank search"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
